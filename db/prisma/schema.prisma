generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UnmatchedMerchantRecordStatus {
  UNMATCHED
  REPROCESSED
  IGNORED
}

enum AccountType {
  INBOUND
  CHARGEBACK
  CHARGEBACK_REVERSAL
  FEES
  SETTLEMENT
  CLEARING_FUNDING
  PRODUCT_FEES
  CLEARING
}

enum AccountStatus {
  ACTIVE
  ON_HOLD
}

enum TransactionStatus {
  PENDING
  SUCCESS
  REJECTED
}

enum EntityType {
  MERCHANT
  INTERNAL // e.g. "Infinites" virtual accounts
}

enum LedgerEntrySide {
  CREDIT
  DEBIT
}

enum TransactionType {
  INBOUND_PAYMENT
  REFUND
  CHARGEBACK
  FEE_PAYMENT
  CHARGEBACK_REVERSAL
  ADJUSTMENT
  CLEARING_TRANSFER
  SETTLEMENT_TRANSFER
  FUNDING_TRANSFER
  NETTING_TRANSFER
  PAYOUT_TRANSFER
}

model Transaction {
  id                      String            @id @default(uuid(7))
  externalSourceReference String           @unique @map("external_source_reference") @db.VarChar(128) // Unique key to avoid duplicate transactions
  reference               String?           @db.VarChar(128) // Optional human-readable reference or description
  currency                String            @db.Char(3)
  type                    TransactionType
  status                  TransactionStatus @default(PENDING)
  failureCode             String?           @map("failure_code") @db.VarChar(50)
  failureMessage          String?           @map("failure_message") @db.VarChar(255)
  transactionDate         DateTime          @map("transaction_date") @db.Date

  parentTransactionId String?       @map("parent_transaction_id") @db.VarChar(36)
  parentTransaction   Transaction?  @relation("TxParentChild", fields: [parentTransactionId], references: [id])
  childTransactions   Transaction[] @relation("TxParentChild")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@index([parentTransactionId])
  @@map("transactions")
}

model VirtualAccount {
  id       String @id @default(uuid(7))
  currency String @db.Char(3)

  accountType     AccountType   @map("account_type")
  acquirerId      String        @default("INTERNAL") @map("acquirer_id") @db.VarChar(36)
  masterAccountId String        @map("master_account_id") @db.VarChar(36)
  masterAccount   MasterAccount @relation(fields: [masterAccountId], references: [id])

  // Current snapshots for quick lookups
  currentBalance Decimal       @default(0) @map("current_balance") @db.Decimal(18, 4)
  status         AccountStatus @default(ACTIVE)
  negativeBalanceSince DateTime? @map("negative_balance_since") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@unique([acquirerId, masterAccountId, currency, accountType], map: "virtual_accounts_acq_id_master_account_id_curr_type_key")
  @@map("virtual_accounts")
}

model LedgerEntry {
  id            String         @id @default(uuid(7))
  accountId     String         @map("account_id")
  account       VirtualAccount @relation(fields: [accountId], references: [id])
  transactionId String         @map("transaction_id") @db.VarChar(36)
  transaction   Transaction    @relation(fields: [transactionId], references: [id])

  description String?         @db.VarChar(255)
  side        LedgerEntrySide
  amount      Decimal         @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([transactionId, accountId, side])
  @@index([accountId])
  @@map("ledger_entries")
}

model UnmatchedMerchantRecord {
  id String @id @default(uuid(7))

  // Data from the settlement file (Daily Movement Report)
  transactionDate DateTime @map("transaction_date") @db.Date
  acquirerName    String   @map("acquirer_name") @db.VarChar(128)
  acquirerId      String   @map("acquirer_id") @db.VarChar(36)
  mid             String   @db.VarChar(36)
  merchantName    String   @map("merchant_name") @db.VarChar(255)
  currency        String   @db.Char(3)
  movementType    String   @map("movement_type") @db.VarChar(64)
  amount          Decimal  @db.Decimal(18, 4)

  // Audit & traceability
  status                   UnmatchedMerchantRecordStatus @default(UNMATCHED)
  ingestionDate            DateTime                      @default(now()) @map("ingestion_date")
  reprocessingDate         DateTime?                     @map("reprocessing_date")
  settlementBatchReference String?                       @map("settlement_batch_reference") @db.VarChar(128)
  masterAccountId          String?                       @map("master_account_id") @db.VarChar(36)
  masterAccount            MasterAccount?                @relation(fields: [masterAccountId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([mid, status])
  @@index([settlementBatchReference])
  @@index([transactionDate])
  @@map("unmatched_merchant_records")
}

model MasterAccount {
  id                       String                    @id @default(uuid(7))
  mid                      String?                   @unique @db.VarChar(36)
  type                     EntityType
  name                     String                    @db.VarChar(255)
  unmatchedMerchantRecords UnmatchedMerchantRecord[]
  virtualAccounts          VirtualAccount[]

  @@map("master_accounts")
}

/// Maps raw settlement-file acquirer codes (e.g. "WP_PRESENTER", "A_003") to the
/// corresponding Acquirer record in the gateway/buddy database.
/// Managed by ops — a new row is inserted whenever a new acquirer is onboarded.
model AcquirerMapping {
  id                Int      @id @default(autoincrement())
  /// The raw code exactly as it appears in the settlement file's acquirer field.
  settlementCode    String   @unique @map("settlement_code") @db.VarChar(64)
  /// The integer primary key of the matching Acquirer row in the gateway database.
  gatewayAcquirerId Int      @map("gateway_acquirer_id")
  /// Human-readable acquirer name — stored for debugging and audit; not used for lookups.
  acquirerName      String   @map("acquirer_name") @db.VarChar(191)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([settlementCode])
  @@map("acquirer_mappings")
}

// This tables use case needs further clarification.
model VirtualMerchantProductFeesAccount {
  id String @id @default(uuid(7))

  acquirerId   String @map("acquirer_id") @db.VarChar(36)
  acquirerName String @map("acquirer_name") @db.VarChar(128)
  merchantId   String @map("merchant_id") @db.VarChar(36)
  merchantName String @map("merchant_name") @db.VarChar(255)

  currency       String   @db.Char(3)
  description    String   @db.VarChar(64)
  processingDate DateTime @map("processing_date") @db.Date

  debit  Decimal @db.Decimal(18, 4)
  credit Decimal @db.Decimal(18, 4)
  total  Decimal @db.Decimal(18, 4)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([acquirerId, merchantId, currency, processingDate, description], map: "vmerchant_prod_fees_acq_mid_curr_date_desc_key")
  @@index([processingDate])
  @@map("virtual_merchant_product_fees_account")
}

enum SettlementPipelineStage {
  SETTLEMENT_FILE_UPLOAD
  SETTLEMENT_FILE_INGESTION
  DAILY_MOVEMENT_PROCESSING
  MERCHANT_SETTLEMENT
  INFINITE_SETTLEMENT
  DAILY_MERCHANT_HELD_REPORT
  MERCHANT_DEFICIT_REPORT
}

enum SettlementProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model SettlementProcessingStage {
  id       String  @id @default(uuid(7))
  parentId String? @map("parent_id")
  rootId   String  @map("root_id")

  stage  SettlementPipelineStage
  status SettlementProcessingStatus @default(PENDING)

  s3Key      String? @map("s3_key")
  retryCount Int     @default(0) @map("retry_count")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  parent   SettlementProcessingStage?  @relation("SettlementProcessingStageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children SettlementProcessingStage[] @relation("SettlementProcessingStageHierarchy")

  @@index([parentId])
  @@index([rootId])
  @@map("settlement_processing_stage")
}
